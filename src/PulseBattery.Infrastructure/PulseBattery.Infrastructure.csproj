<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0-windows</TargetFramework>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <DeviceBackendPowerShell Condition="'$(DeviceBackendPowerShell)' == '' and Exists('$(ProgramW6432)/PowerShell/7/pwsh.exe')">$(ProgramW6432)/PowerShell/7/pwsh.exe</DeviceBackendPowerShell>
    <DeviceBackendPowerShell Condition="'$(DeviceBackendPowerShell)' == ''">powershell</DeviceBackendPowerShell>
  </PropertyGroup>

  <ItemGroup><ProjectReference Include="../PulseBattery.Core/PulseBattery.Core.csproj" /></ItemGroup>
  <Target Name="BuildDeviceBackend" BeforeTargets="PrepareForBuild">
    <Exec Command="&quot;$(DeviceBackendPowerShell)&quot; -NoProfile -ExecutionPolicy Bypass -File &quot;$(MSBuildProjectDirectory)/../../scripts/Build-DeviceBackend.ps1&quot;" />
  </Target>
  <ItemGroup>
    <EmbeddedResource Include="../../artifacts/device-backend/DeviceBackend.zip" LogicalName="PulseBattery.DeviceBackend.zip" />
  </ItemGroup>
</Project>
