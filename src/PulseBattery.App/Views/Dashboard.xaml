<Window x:Class="PulseBattery.App.Views.Dashboard"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="clr-namespace:PulseBattery.App.Controls"
        xmlns:loc="clr-namespace:PulseBattery.App.Localization"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        Title="{loc:Text WindowTitle}" Style="{DynamicResource {x:Type Window}}" Width="960" Height="690" MinWidth="780" MinHeight="630"
        WindowStartupLocation="CenterScreen" WindowStyle="None" ResizeMode="CanResize" StateChanged="OnStateChanged">
    <Window.Resources><ResourceDictionary Source="../Themes/Dark.xaml" /></Window.Resources>
    <shell:WindowChrome.WindowChrome><shell:WindowChrome CaptionHeight="52" CornerRadius="12" ResizeBorderThickness="6" GlassFrameThickness="0" /></shell:WindowChrome.WindowChrome>
    <Border BorderBrush="#303A33" BorderThickness="1">
    <Grid>
        <Grid.RowDefinitions><RowDefinition Height="54" /><RowDefinition Height="*" /><RowDefinition Height="46" /></Grid.RowDefinitions>
        <Grid Margin="28,0,12,0">
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center"><TextBlock Text="ϟ" Foreground="{StaticResource AccentBrush}" FontSize="28" Margin="0,0,9,0" /><TextBlock Text="pulse" FontSize="19" FontWeight="SemiBold" /><TextBlock Text="{loc:Text Tagline}" FontSize="9" Foreground="{StaticResource MutedBrush}" Margin="15,3,0,0" /></StackPanel>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" shell:WindowChrome.IsHitTestVisibleInChrome="True">
                <Button Content="{loc:Text Settings}" Style="{StaticResource QuietButton}" Click="ToggleSettings" Margin="0,5,12,5" AutomationProperties.AutomationId="OpenSettings" />
                <Button Content="—" ToolTip="{loc:Text Minimize}" Style="{StaticResource QuietButton}" Click="Minimize" Width="40" />
                <Button Content="×" ToolTip="{loc:Text Hide}" Style="{StaticResource QuietButton}" FontSize="22" Click="HideWindow" Width="40" />
            </StackPanel>
        </Grid>
        <ScrollViewer x:Name="DeviceScroll" Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <Grid Margin="34,22,34,18">
            <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
            <Grid>
                <StackPanel><TextBlock Text="{loc:Text Eyebrow}" FontSize="10" Foreground="{StaticResource AccentBrush}" FontWeight="SemiBold" />
                    <TextBlock Text="{loc:Text Headline}" FontSize="34" FontWeight="SemiBold" Margin="0,8,0,7" />
                    <TextBlock Text="{loc:Text Subtitle}" Foreground="{StaticResource MutedBrush}" />
                </StackPanel>
                <Border HorizontalAlignment="Right" VerticalAlignment="Center" Background="#1B2A20" CornerRadius="16" Padding="13,7"><TextBlock Text="{loc:Text Live}" FontSize="10" Foreground="{StaticResource AccentBrush}" /></Border>
            </Grid>
            <Grid Grid.Row="1" Margin="0,29,0,14">
                <StackPanel Orientation="Horizontal"><TextBlock Text="{Binding DeviceCount}" Foreground="{StaticResource MutedBrush}" FontSize="10" FontWeight="SemiBold" />
                    <TextBlock Text="{loc:Text ReorderHint}" Foreground="{StaticResource MutedBrush}" FontSize="10" Margin="14,0,0,0" />
                </StackPanel>
                <Button HorizontalAlignment="Right" Content="{Binding RefreshLabel}" Command="{Binding RefreshCommand}" Padding="12,7" FontSize="11" AutomationProperties.AutomationId="DashboardRefresh" />
            </Grid>
            <ItemsControl x:Name="DeviceCards" Grid.Row="2" ItemsSource="{Binding Devices}" Margin="-6,0,-6,0">
                <ItemsControl.ItemsPanel><ItemsPanelTemplate><UniformGrid Columns="2" /></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate><DataTemplate>
                    <Border Background="{StaticResource SurfaceBrush}" BorderBrush="{StaticResource LineBrush}" BorderThickness="1" CornerRadius="16" Margin="6,0,6,12" Padding="23,21"
                            Cursor="SizeAll" AllowDrop="True" PreviewMouseLeftButtonDown="CardPointerDown" PreviewMouseMove="CardPointerMove"
                            DragOver="CardDragOver" DragLeave="CardDragLeave" Drop="CardDrop">
                        <Grid><Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                            <Grid><Button x:Name="DeviceIconPicker" Style="{StaticResource DeviceIconButton}" HorizontalAlignment="Left" Cursor="Hand"
                                          ToolTip="{loc:Text ChangeDeviceIcon}" AutomationProperties.Name="{loc:Text ChangeDeviceIcon}" AutomationProperties.HelpText="{Binding Name}" AutomationProperties.AutomationId="DeviceIconPicker"
                                          Click="OpenDeviceIconMenu" ContextMenuOpening="DeviceIconContextMenuOpening">
                                    <controls:DeviceGlyph Kind="{Binding Kind}" Foreground="{Binding Accent}" Width="29" Height="29" />
                                    <Button.ContextMenu><ContextMenu Style="{StaticResource PulseContextMenu}" /></Button.ContextMenu>
                                </Button>
                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Top"><TextBlock Text="{Binding Badge}" Foreground="{Binding Accent}" FontSize="10" Margin="0,0,10,0" />
                                    <controls:SvgIcon Asset="drag-handle" Width="14" Height="18" Foreground="{StaticResource MutedBrush}" ToolTip="{loc:Text ReorderDevice}" />
                                </StackPanel>
                            </Grid>
                            <StackPanel Grid.Row="1" Margin="0,21,0,0"><TextBlock Text="{Binding Category}" Foreground="{StaticResource MutedBrush}" FontSize="9" />
                                <TextBlock Text="{Binding Name}" FontSize="17" FontWeight="SemiBold" Margin="0,5,0,0" TextTrimming="CharacterEllipsis" ToolTip="{Binding Name}" />
                            </StackPanel>
                            <Grid Grid.Row="2" Margin="0,15,0,0"><StackPanel Orientation="Horizontal"><TextBlock Text="{Binding Level}" Foreground="{Binding Accent}" FontSize="53" FontWeight="Light" /><TextBlock Text="{Binding Percent}" FontSize="22" Foreground="{StaticResource MutedBrush}" Margin="4,16,0,0" /></StackPanel>
                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,0,12"><controls:ChargingIndicator Width="13" Height="12" Margin="0,0,6,0" Foreground="{Binding Accent}" Visibility="{Binding IsCharging, Converter={StaticResource BoolVisibility}}" /><TextBlock Text="{Binding Status}" FontSize="11" Foreground="{StaticResource MutedBrush}" /></StackPanel>
                            </Grid>
                            <StackPanel Grid.Row="3"><ProgressBar Value="{Binding Progress, Mode=OneWay}" Visibility="{Binding ShowProgress, Converter={StaticResource BoolVisibility}}" Foreground="{Binding Accent}" Margin="0,8,0,15" /><TextBlock Text="{Binding Connection}" Foreground="{StaticResource MutedBrush}" FontSize="10" TextWrapping="Wrap" />
                                <CheckBox Content="{loc:Text ShowOnTaskbar}" IsChecked="{Binding ShowOnTaskbar}" FontSize="11" Margin="0,15,0,0" Foreground="{StaticResource MutedBrush}"
                                          AutomationProperties.Name="{loc:Text ShowOnTaskbar}" AutomationProperties.HelpText="{Binding Name}" AutomationProperties.AutomationId="DeviceTaskbarVisibility" />
                            </StackPanel>
                        </Grid>
                    </Border>
                </DataTemplate></ItemsControl.ItemTemplate>
            </ItemsControl>
            <Border Grid.Row="2" Visibility="{Binding IsEmpty, Converter={StaticResource BoolVisibility}}" Background="{StaticResource SurfaceBrush}" CornerRadius="16" Padding="32" MinHeight="260">
                <StackPanel VerticalAlignment="Center"><TextBlock Text="{loc:Text ConnectTitle}" FontSize="23" Margin="0,0,0,12" /><TextBlock Text="{loc:Text ConnectDescription}" TextWrapping="Wrap" Foreground="{StaticResource MutedBrush}" /><Button Content="{loc:Text Retry}" Command="{Binding RefreshCommand}" HorizontalAlignment="Left" Margin="0,20,0,0" /></StackPanel>
            </Border>
            <Border Grid.Row="3" Background="#18231C" BorderBrush="#2B3A2F" BorderThickness="1" CornerRadius="12" Padding="17,14" Margin="0,4,0,0">
                <Grid><StackPanel Orientation="Horizontal"><TextBlock Text="✓" FontSize="18" Foreground="{StaticResource AccentBrush}" Margin="0,0,12,0" /><StackPanel><TextBlock Text="{Binding Health}" FontSize="12" /><TextBlock Text="{Binding RefreshHint}" FontSize="10" Foreground="{StaticResource MutedBrush}" Margin="0,4,0,0" /></StackPanel></StackPanel>
                    <Button Content="{loc:Text TaskbarButton}" Click="ToggleTaskbarPanel" Style="{StaticResource QuietButton}" HorizontalAlignment="Right" FontSize="11" />
                </Grid>
            </Border>
            <TextBlock Grid.Row="4" Text="{Binding Error}" Visibility="{Binding HasError, Converter={StaticResource BoolVisibility}}" Foreground="#FFAC99" TextWrapping="Wrap" Margin="0,12,0,0" />
        </Grid>
        </ScrollViewer>
        <Border Grid.Row="2" BorderBrush="{StaticResource LineBrush}" BorderThickness="0,1,0,0" Padding="34,0">
            <Grid><TextBlock Text="{Binding Status}" FontSize="10" Foreground="{StaticResource MutedBrush}" /><StackPanel Orientation="Horizontal" HorizontalAlignment="Right"><TextBlock Text="{loc:Text BackgroundStatus}" Foreground="{StaticResource MutedBrush}" FontSize="10" Margin="0,0,18,0" /><Button Content="{loc:Text Exit}" Click="ExitApp" Style="{StaticResource QuietButton}" FontSize="10" /></StackPanel></Grid>
        </Border>
        <Border Grid.Row="1" Width="345" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,8,22,0" Padding="22" Background="#202923" BorderBrush="#415047" BorderThickness="1" CornerRadius="14" Visibility="{Binding SettingsOpen, Converter={StaticResource BoolVisibility}}">
            <ScrollViewer x:Name="SettingsScroll" Style="{StaticResource SettingsScrollViewer}" AutomationProperties.AutomationId="SettingsScroll">
            <StackPanel><Grid><TextBlock Text="{loc:Text Settings}" FontSize="20" FontWeight="SemiBold" /><Button Content="×" Click="ToggleSettings" HorizontalAlignment="Right" Style="{StaticResource QuietButton}" Padding="6,4" /></Grid>
                <TextBlock Text="{loc:Text Language}" Foreground="{StaticResource MutedBrush}" Margin="0,12,0,6" />
                <ComboBox x:Name="LanguageSelector" ItemsSource="{Binding Languages}" DisplayMemberPath="Name" SelectedValuePath="Code" SelectedValue="{Binding Language}" Padding="8,5" Foreground="Black" AutomationProperties.AutomationId="LanguageSelector">
                    <ComboBox.ItemContainerStyle><Style TargetType="ComboBoxItem"><Setter Property="Foreground" Value="Black" /><Setter Property="Background" Value="White" /><Setter Property="Padding" Value="8,6" /></Style></ComboBox.ItemContainerStyle>
                </ComboBox>
                <TextBlock Text="{loc:Text PulseTrayHint}" Foreground="{StaticResource MutedBrush}" FontSize="10" TextWrapping="Wrap" Margin="0,12,0,0" />
                <TextBlock Text="{loc:Text TaskbarLayout}" Margin="0,14,0,6" FontWeight="SemiBold" />
                <Grid Margin="0,0,0,4"><TextBlock Text="{loc:Text TaskbarHorizontal}" /><TextBlock Text="{loc:Text TaskbarCompact}" HorizontalAlignment="Right" /></Grid>
                <Slider x:Name="TaskbarLayoutSlider" Value="{Binding TaskbarLayoutMode}" Minimum="0" Maximum="1" TickFrequency="1" IsSnapToTickEnabled="True" SmallChange="1" LargeChange="1" IsMoveToPointEnabled="True" AutomationProperties.AutomationId="TaskbarLayout" AutomationProperties.Name="{loc:Text TaskbarLayout}" />
                <TextBlock Text="{loc:Text TaskbarLayoutHint}" Foreground="{StaticResource MutedBrush}" FontSize="10" TextWrapping="Wrap" Margin="0,6,0,2" />
                <Border BorderBrush="#415047" BorderThickness="1" CornerRadius="8" Padding="10" Margin="0,8,0,0"><StackPanel>
                <TextBlock Text="{loc:Text TaskbarHorizontal}" FontWeight="SemiBold" />
                <TextBlock Text="{loc:Text TaskbarHorizontalHint}" Foreground="{StaticResource MutedBrush}" FontSize="10" Margin="0,3,0,0" />
                <TextBlock Text="{loc:Text IndicatorScale}" Foreground="{StaticResource MutedBrush}" Margin="0,10,0,6" />
                <DockPanel><TextBlock Text="{Binding TaskbarScalePercent, StringFormat={}{0}%}" DockPanel.Dock="Right" Width="42" TextAlignment="Right" /><Slider x:Name="TaskbarScaleSlider" Value="{Binding TaskbarScalePercent}" Minimum="80" Maximum="150" TickFrequency="1" IsSnapToTickEnabled="True" VerticalAlignment="Center" AutomationProperties.AutomationId="TaskbarScale" AutomationProperties.Name="{loc:Text TaskbarSize}" /></DockPanel>
                <TextBlock Text="{loc:Text TaskbarSpacing}" Foreground="{StaticResource MutedBrush}" Margin="0,12,0,6" />
                <DockPanel><TextBlock Text="{Binding TaskbarSpacing}" DockPanel.Dock="Right" Width="42" TextAlignment="Right" /><Slider x:Name="TaskbarSpacingSlider" Value="{Binding TaskbarSpacing}" Minimum="0" Maximum="24" TickFrequency="1" IsSnapToTickEnabled="True" VerticalAlignment="Center" AutomationProperties.AutomationId="TaskbarSpacing" AutomationProperties.Name="{loc:Text TaskbarSpacing}" /></DockPanel>
                </StackPanel></Border>
                <Border BorderBrush="#415047" BorderThickness="1" CornerRadius="8" Padding="10" Margin="0,8,0,0"><StackPanel>
                <TextBlock Text="{loc:Text TaskbarCompact}" FontWeight="SemiBold" />
                <TextBlock Text="{loc:Text TaskbarCompactHint}" Foreground="{StaticResource MutedBrush}" FontSize="10" Margin="0,3,0,0" />
                <TextBlock Text="{loc:Text IndicatorScale}" Foreground="{StaticResource MutedBrush}" Margin="0,10,0,6" />
                <DockPanel><TextBlock Text="{Binding TaskbarCompactScalePercent, StringFormat={}{0}%}" DockPanel.Dock="Right" Width="42" TextAlignment="Right" /><Slider x:Name="TaskbarCompactScaleSlider" Value="{Binding TaskbarCompactScalePercent}" Minimum="80" Maximum="150" TickFrequency="1" IsSnapToTickEnabled="True" VerticalAlignment="Center" AutomationProperties.AutomationId="TaskbarCompactScale" AutomationProperties.Name="{loc:Text TaskbarSize}" /></DockPanel>
                <TextBlock Text="{loc:Text TaskbarSpacing}" Foreground="{StaticResource MutedBrush}" Margin="0,12,0,6" />
                <DockPanel><TextBlock Text="{Binding TaskbarCompactSpacing}" DockPanel.Dock="Right" Width="42" TextAlignment="Right" /><Slider x:Name="TaskbarCompactSpacingSlider" Value="{Binding TaskbarCompactSpacing}" Minimum="0" Maximum="24" TickFrequency="1" IsSnapToTickEnabled="True" VerticalAlignment="Center" AutomationProperties.AutomationId="TaskbarCompactSpacing" AutomationProperties.Name="{loc:Text TaskbarSpacing}" /></DockPanel>
                </StackPanel></Border>
                <TextBlock Text="{loc:Text RefreshSeconds}" Foreground="{StaticResource MutedBrush}" Margin="0,14,0,6" />
                <DockPanel><TextBlock Text="{Binding RefreshSeconds}" DockPanel.Dock="Right" Width="35" TextAlignment="Right" /><Slider Value="{Binding RefreshSeconds}" Minimum="15" Maximum="300" TickFrequency="15" IsSnapToTickEnabled="True" VerticalAlignment="Center" /></DockPanel>
                <TextBlock Text="{loc:Text LowThreshold}" Foreground="{StaticResource MutedBrush}" Margin="0,14,0,6" />
                <DockPanel><TextBlock Text="{Binding LowBatteryThreshold}" DockPanel.Dock="Right" Width="35" TextAlignment="Right" /><Slider Value="{Binding LowBatteryThreshold}" Minimum="5" Maximum="40" TickFrequency="5" IsSnapToTickEnabled="True" VerticalAlignment="Center" /></DockPanel>
                <CheckBox Content="{loc:Text Notifications}" IsChecked="{Binding Notifications}" Margin="0,16,0,0" />
                <CheckBox Content="{loc:Text TaskbarSetting}" IsChecked="{Binding TaskbarPanel}" Margin="0,8,0,0" />
                <CheckBox Content="{loc:Text StartWithWindows}" IsChecked="{Binding StartWithWindows}" Margin="0,8,0,0" />
                <TextBlock Text="{loc:Text AutoSave}" Foreground="{StaticResource MutedBrush}" FontSize="10" Margin="0,12,0,0" />
            </StackPanel>
            </ScrollViewer>
        </Border>
    </Grid>
    </Border>
</Window>
