<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <ImplicitUsings>disable</ImplicitUsings>
    <AssemblyName>PulseBattery</AssemblyName>
    <Version>0.1.0</Version>
    <ApplicationIcon>Assets/Pulse.ico</ApplicationIcon>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <TieredCompilation>false</TieredCompilation>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="../PulseBattery.Infrastructure/PulseBattery.Infrastructure.csproj" />
    <Resource Include="Assets/*.svg" />
  </ItemGroup>
</Project>
